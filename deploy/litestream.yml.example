# Litestream configuration for continuous backup of the task-server database.
#
# Copy this file into the deployment that owns the credentials and mount it at
# /etc/litestream.yml in a Litestream sidecar. The sidecar shares one local
# named volume with the server container, so both processes reach the same
# /app/data/task-server.db on the same Docker host.
#
# Every value that names or opens the bucket is an environment reference.
# Nothing here may be replaced with a literal: this file is in version control
# and a bucket name, an endpoint, or a key would then be too. Litestream expands
# ${...} from its own environment when it reads the config.
#
#   R2_ENDPOINT           the S3 API endpoint of the R2 account
#   R2_BUCKET             the bucket that holds the replica
#   R2_PREFIX             the path inside the bucket, so one bucket can hold
#                         more than one database
#   R2_ACCESS_KEY_ID      R2 API token, injected as a secret
#   R2_SECRET_ACCESS_KEY  R2 API token, injected as a secret
#
# Only the database path and `region: auto` are fixed: the path is where the
# image puts the database, and R2 has one region.

dbs:
  - path: /app/data/task-server.db
    replica:
      type: s3
      endpoint: ${R2_ENDPOINT}
      bucket: ${R2_BUCKET}
      path: ${R2_PREFIX}
      region: auto
      access-key-id: ${R2_ACCESS_KEY_ID}
      secret-access-key: ${R2_SECRET_ACCESS_KEY}
